{
  "version": 1,
  "cases": [
    {
      "caseId": "reference-followup-history",
      "description": "上一轮候选学校的历史分数查询",
      "turns": [
        {"content": "找几所适合我的学校"},
        {"content": "查那几个学校去年的分数"}
      ],
      "expectations": {
        "requiredEntityIds": ["school-1", "school-2"],
        "responseType": "fact",
        "evidenceRequired": true
      }
    },
    {
      "caseId": "missing-history-scope",
      "description": "历史分数缺少必要查询参数时先澄清",
      "turns": [
        {"content": "查这几个学校去年的分数"}
      ],
      "expectations": {
        "requiredToolNames": ["admission.get_history"],
        "clarificationRequired": true
      }
    },
    {
      "caseId": "constraint-change-preview",
      "description": "太贵和去掉第三个只形成只读预览，不直接写入",
      "turns": [
        {"content": "这些学校里太贵的去掉第三个"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "clarificationRequired": true
      }
    },
    {
      "caseId": "confirmation-before-write",
      "description": "方案保存前必须产生确认或 Proposal",
      "turns": [
        {"content": "就按这个方案保存"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "proposalRequired": true
      }
    },
    {
      "caseId": "partial-read-result",
      "description": "多校只读查询部分成功时明确覆盖范围和下一步",
      "turns": [
        {"content": "查这些学校的历史分数"}
      ],
      "expectations": {
        "responseType": "fact",
        "requiredToolNames": ["admission.get_history"],
        "evidenceRequired": true,
        "executionStatus": "partial",
        "limitationsRequired": true,
        "nextStepRequired": true
      }
    },
    {
      "caseId": "blocked-read-result",
      "description": "查询缺少参数时输出阻塞状态和补参下一步",
      "turns": [
        {"content": "查那几个学校去年的分数"}
      ],
      "expectations": {
        "responseType": "fact",
        "executionStatus": "partial",
        "limitationsRequired": true,
        "nextStepRequired": true,
        "proposalRequired": true,
        "clarificationRequired": false
      }
    },
    {
      "caseId": "mixed-read-and-write-request",
      "description": "同一轮同时查询事实和修改方案时，先完成只读部分并阻止写入",
      "turns": [
        {"content": "查这几个学校的历史分数，然后把第三个从方案里删掉"}
      ],
      "expectations": {
        "requiredToolNames": ["admission.get_history"],
        "forbiddenToolNames": ["plan_apply"],
        "responseType": "fact",
        "executionStatus": "partial",
        "limitationsRequired": true,
        "nextStepRequired": true,
        "proposalRequired": true,
        "clarificationRequired": false
      }
    },
    {
      "caseId": "followup-confirm-proposal",
      "description": "用户明确确认当前 Proposal 时输出确认动作，不重新解释自然语言",
      "turns": [
        {"content": "先把第三个学校从方案中移除，给我看看变更"},
        {"content": "确认，就按这个删掉"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "proposalRequired": true
      }
    },
    {
      "caseId": "followup-cancel-proposal",
      "description": "用户取消当前 Proposal 时不执行写入",
      "turns": [
        {"content": "生成删除第三个学校的方案变更"},
        {"content": "算了，不删了"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "proposalRequired": false
      }
    },
    {
      "caseId": "ambiguous-reference-clarification",
      "description": "存在多个候选集合时，模糊指代先澄清而不是猜测",
      "turns": [
        {"content": "分别找一组保守和冲刺学校"},
        {"content": "查它们的历史分数"}
      ],
      "expectations": {
        "clarificationRequired": true,
        "nextStepRequired": true
      }
    }
  ]
}
