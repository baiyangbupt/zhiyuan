{
  "version": 1,
  "cases": [
    {
      "caseId": "reference-followup-history",
      "description": "上一轮候选学校的历史分数查询",
      "turns": [
        {"content": "找几所适合我的学校"},
        {"content": "查那几个学校去年的分数"}
      ],
      "expectations": {
        "requiredEntityIds": ["school-1", "school-2"],
        "responseType": "fact",
        "evidenceRequired": true
      }
    },
    {
      "caseId": "missing-history-scope",
      "description": "历史分数缺少必要查询参数时先澄清",
      "turns": [
        {"content": "查这几个学校去年的分数"}
      ],
      "expectations": {
        "requiredToolNames": ["admission.get_history"],
        "clarificationRequired": true
      }
    },
    {
      "caseId": "constraint-change-preview",
      "description": "太贵和去掉第三个只形成只读预览，不直接写入",
      "turns": [
        {"content": "这些学校里太贵的去掉第三个"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "clarificationRequired": true
      }
    },
    {
      "caseId": "confirmation-before-write",
      "description": "方案保存前必须产生确认或 Proposal",
      "turns": [
        {"content": "就按这个方案保存"}
      ],
      "expectations": {
        "forbiddenToolNames": ["plan_apply"],
        "proposalRequired": true
      }
    },
    {
      "caseId": "partial-read-result",
      "description": "多校只读查询部分成功时明确覆盖范围和下一步",
      "turns": [
        {"content": "查这些学校的历史分数"}
      ],
      "expectations": {
        "responseType": "fact",
        "requiredToolNames": ["admission.get_history"],
        "evidenceRequired": true,
        "executionStatus": "partial",
        "limitationsRequired": true,
        "nextStepRequired": true
      }
    },
    {
      "caseId": "blocked-read-result",
      "description": "查询缺少参数时输出阻塞状态和补参下一步",
      "turns": [
        {"content": "查那几个学校去年的分数"}
      ],
      "expectations": {
        "responseType": "clarification",
        "executionStatus": "blocked",
        "limitationsRequired": true,
        "nextStepRequired": true,
        "clarificationRequired": true
      }
    },
    {
      "caseId": "mixed-read-and-write-request",
      "description": "同一轮同时查询事实和修改方案时，先完成只读部分并阻止写入",
      "turns": [
        {"content": "查这几个学校的历史分数，然后把第三个从方案里删掉"}
      ],
      "expectations": {
        "requiredToolNames": ["admission.get_history"],
        "forbiddenToolNames": ["plan_apply"],
        "responseType": "clarification",
        "executionStatus": "blocked",
        "limitationsRequired": true,
        "nextStepRequired": true,
        "clarificationRequired": true
      }
    }
  ]
}
