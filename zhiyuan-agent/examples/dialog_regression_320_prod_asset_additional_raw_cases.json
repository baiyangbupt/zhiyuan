    {
      "name": "320-prod-additional-long-tiered-major-preference",
      "sessionId": "99320401",
      "sourceSessionId": "3643",
      "flow": [
        "long_preference",
        "tiered_major_preference",
        "negative_major_preference"
      ],
      "coverage": [
        "production_dialogue_source",
        "long_tiered_preference",
        "strategy_schema",
        "negative_preference"
      ],
      "prompts": [
        {
          "prompt": "我需要将专业方向分为以下三个梯队： 一、本科专业 第一梯队： (a) 教育学类：小学教育 (b) 医学类：护理学 (c) 工学类：航空航天类（低空经济航空服务方向） 第二梯队： (a) 管理学类：会计学 (b) 农学类：茶学 (c) 理学类：应用气象学（大气科学方向） (d) 交通运输类：交通运输（铁道管理、城市轨道交通方向） 第三梯队： (a) 经济学类：财政学、税收学、国际经济与贸易 (b) 工学类：数字媒体技术、邮政工程 (c) 管理学类：邮政工程 不考虑方向： 哲学类、法学类、历史学类、汉语言文学、纯新闻学类、数学类、物理等基础学科，以及计算机强的一些理工科。 二、专科专业 第一梯队： 小学教育、护理、空乘民航运输业务（对应低空经济方向）、铁道运输类（铁道运营管理）、交通（城市轨道交通管理）。 第二梯队： 大数据与会计、茶叶生产与加工技术、大气科学。 第三梯队： 国际经济与贸易、数字媒体技术、邮政快递管理运营。",
          "assertContainsAny": [
            "第一梯队",
            "第二梯队",
            "第三梯队",
            "小学教育",
            "护理",
            "航空航天",
            "不考虑",
            "采纳"
          ],
          "assertNotContains": [
            "偏好专业：第一梯队",
            "偏好专业：第二梯队",
            "偏好专业：第三梯队",
            "具体专业：不考虑"
          ],
          "qualityFocus": [
            "long_preference_preservation",
            "tiered_preference_not_literal_major",
            "negative_preference"
          ]
        }
      ]
    },
