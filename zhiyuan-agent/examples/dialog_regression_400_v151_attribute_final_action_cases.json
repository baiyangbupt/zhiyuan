{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.51 final-action checks for explicit school/program attribute requirements.",
    "notes": "Run with --clone-backend-chat-session when using cloned sessions. These cases verify that natural explicit requirements are recorded and applied to the final ordered plan, not only rendered as confirmation cards."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "attribute_requirement",
      "final_action"
    ],
    "coverage": [
      "explicit_requirement",
      "school_attribute",
      "program_attribute",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "16",
    "fixtureContract": {
      "type": "formal_plan_present",
      "requiredState": [
        "orderedPlan",
        "formalPlan"
      ]
    },
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v151-exclude-private-school-final-action",
      "sessionId": "9904511",
      "prompts": [
        {
          "prompt": "民办的不要",
          "assertContainsAny": [
            "民办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已采纳",
            "民办",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeSchools",
              "contains": "院校性质:民办"
            },
            {
              "key": "planningState",
              "path": "candidatePoolState.items",
              "contains": "民办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "lengthLessThanBefore": true,
              "minLength": 1
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true,
              "minLength": 1
            }
          ]
        }
      ]
    },
    {
