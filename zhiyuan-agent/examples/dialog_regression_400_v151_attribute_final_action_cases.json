            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeSchools",
              "contains": "招生类型:高收费"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
              "maxNumericFieldLessThanOrEqual": {
                "field": "tuitionPerYear",
                "value": 20000
              }
            }
          ]
        }
      ]
    }
  ]
}
