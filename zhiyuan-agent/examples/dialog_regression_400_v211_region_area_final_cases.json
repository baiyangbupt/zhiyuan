{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v2.11 region area requirement final-action checks for explicit colloquial area expressions.",
    "notes": "Run with --clone-backend-chat-session. Verifies area-level region requirements such as 南方/北方 create pending previews and apply to confirmed constraints and ordered plan refresh."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "region_area",
      "confirm_pending",
      "final_action"
    ],
    "coverage": [
      "explicit_requirement",
      "region_area",
      "spoken_expression",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "18",
    "fixtureContract": {
      "type": "formal_plan_present",
      "requiredState": [
        "orderedPlan",
        "formalPlan"
      ]
    },
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v211-region-south-north-final-action",
      "sessionId": "9904711",
      "prompts": [
        {
          "prompt": "孩子就想去南方，北方先别考虑",
          "assertContainsAny": [
            "南方",
            "北方",
            "确认",
            "地域",
            "方案"
          ],
          "assertToolNamesContain": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1,
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "assertActionFamiliesContain": [
            "apply_selected_intents"
          ]
        },
        {
          "prompt": "确认",
          "assertContainsAny": [
            "已采纳",
            "当前方案",
            "报考要求"
          ],
          "assertToolNamesContain": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustIncludeRegions",
              "contains": "南方"
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "contains": "北方"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "minLength": 1
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "notContains": "北京"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "notContains": "山东"
            }
          ]
        }
      ]
    }
  ]
}
