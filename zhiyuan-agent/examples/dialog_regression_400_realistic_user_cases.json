{
  "metadata": {
    "release": "4.0.0",
    "purpose": "Realistic spoken/elliptical user style cases for ZhiyuanAgent shadow validation.",
    "notes": "Keep formal written cases, but validate everyday short utterances, references, and abbreviated follow-ups. Run with ZHIYUAN_AGENT_POC_SHADOW=1 to assert the 4.0 agent shadow tool choice."
  },
  "defaults": {
    "flow": [
      "plan",
      "review",
      "intent"
    ],
    "coverage": [
      "release_4_0_0",
      "realistic_user_input",
      "spoken_style",
      "ellipsis",
      "zhiyuan_agent_shadow"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "26",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "qualityFocus": [
        "realistic_user_input",
        "user_language",
        "tool_choice_stability"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180,
      "expectedZhiyuanAgentPocStatus": "success",
      "maxZhiyuanAgentPocToolCallCount": 2
    }
  },
  "cases": [
    {
      "name": "400-realistic-review-problem-and-solution-short",
      "sessionId": "9904001",
      "coverage": [
        "review_readonly",
        "spoken_review_request",
        "no_side_effect"
      ],
      "prompts": [
        {
          "prompt": "有啥问题，咋弄",
          "assertContainsAny": [
            "问题",
            "风险",
            "处理",
            "可以先",
            "建议"
          ],
          "assertNoFollowups": true,
          "expectedZhiyuanAgentPocFirstToolNames": [
            "review_plan"
          ],
          "expectedZhiyuanAgentPocNextSteps": [
            "respond"
          ]
        }
      ]
    },
    {
      "name": "400-realistic-remove-expensive-after-review-reference",
      "sessionId": "9904002",
      "coverage": [
        "review_then_plan_action",
        "short_followup_reference",
        "high_tuition_remove"
      ],
      "prompts": [
        {
          "prompt": "有啥问题，咋弄",
          "assertContainsAny": [
            "高收费",
            "中外合作",
            "风险",
            "问题",
            "处理"
          ],
          "assertNoFollowups": true,
          "expectedZhiyuanAgentPocFirstToolNames": [
            "review_plan"
          ],
          "expectedZhiyuanAgentPocNextSteps": [
            "respond"
          ]
        },
        {
          "prompt": "那高收费的别要了",
          "assertContainsAny": [
            "高收费",
            "移出",
            "确认",
            "采纳"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedZhiyuanAgentPocFirstToolNames": [
            "preview_plan_action"
          ],
          "expectedZhiyuanAgentPocNextSteps": [
            "confirm"
          ]
        }
      ]
    },
    {
      "name": "400-realistic-intent-private-short",
      "sessionId": "9904003",
