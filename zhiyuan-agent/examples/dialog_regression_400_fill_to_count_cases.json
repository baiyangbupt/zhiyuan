            {
              "key": "planningState",
              "path": "candidatePoolState.requiredCount",
              "equals": 50
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthEquals": 50
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "民办"
            }
          ]
        }
      ]
    },
    {
