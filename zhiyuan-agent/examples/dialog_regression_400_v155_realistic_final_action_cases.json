{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.55 realistic spoken/deictic final-action checks.",
    "notes": "Run with --clone-backend-chat-session. These cases keep formal final-action cases, but add everyday short utterances and follow-up references, verifying final backend plan changes after confirmation."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "realistic_user_input",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "ellipsis",
      "deictic_reference",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "17",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v155-review-reference-remove-high-tuition-final-action",
      "sessionId": "9904551",
      "coverage": [
        "review_then_plan_action",
        "short_followup_reference",
        "high_tuition_remove",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "有啥问题，咋弄",
          "assertContainsAny": [
            "问题",
            "风险",
            "处理",
            "高收费",
            "中外合作"
          ],
          "assertNoFollowups": true,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "review_plan"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "那高收费的别要了",
          "assertContainsAny": [
            "高收费",
            "移出",
            "确认",
            "采纳"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_plan_action"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "确认执行",
          "assertContainsAny": [
            "已移出",
            "已执行",
            "已更新",
            "刷新"
          ],
          "assertNoFollowups": true,
          "assertActionableFollowupTypes": [
            "planningWorkspaceAction"
          ],
          "assertActionableFollowupTargets": [
            "ordered",
            "review"
          ],
          "assertActionableFollowupCount": 2,
          "expectedRoutingPathAny": [
            "direct_pending_plan_confirm",
            "pending_plan_short_text_confirm",
            "pending_plan_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "37020261001095_37020262020504_709"
            }
          ]
        }
      ]
    },
    {
      "name": "400-v155-current-plan-private-remove-final-action",
      "sessionId": "9904552",
      "coverage": [
        "plan_action",
        "current_plan_anchor",
        "school_nature",
