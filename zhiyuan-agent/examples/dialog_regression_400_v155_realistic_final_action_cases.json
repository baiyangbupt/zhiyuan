          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已移出",
            "已执行",
            "已更新",
            "刷新"
          ],
          "assertNoFollowups": true,
          "assertActionableFollowupTypes": [
            "planningWorkspaceAction"
          ],
          "assertActionableFollowupTargets": [
            "ordered",
            "review"
          ],
          "assertActionableFollowupCount": 2,
          "expectedRoutingPathAny": [
            "direct_pending_plan_confirm",
            "pending_plan_short_text_confirm",
            "pending_plan_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "37020261000269_37020262005080_709"
            }
          ]
        }
      ]
    },
    {
      "name": "400-v155-region-bare-spoken-final-action",
      "sessionId": "9904553",
      "coverage": [
        "intent_change",
        "region",
        "bare_constraint",
        "short_negative_expression",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "山东别去了",
          "assertContainsAny": [
            "山东",
            "确认",
            "采纳",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已采纳",
            "山东",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "candidateViewState.filters.negativeProvinceNames",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "candidatePoolState.items",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "山东"
            }
          ]
        }
      ]
    }
  ]
}
