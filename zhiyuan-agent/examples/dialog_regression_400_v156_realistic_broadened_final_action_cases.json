{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.56 broadened realistic spoken final-action checks.",
    "notes": "Run with --clone-backend-chat-session. These cases broaden everyday short utterances across include, exclude, taxonomy, tag, and deferred apply-to-current-plan semantics, verifying final backend changes after confirmation."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "realistic_user_input",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "ellipsis",
      "attribute_requirement",
      "major_requirement",
      "tag_requirement",
      "deferred_current_plan_apply",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "17",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v156-spoken-only-public-final-action",
      "sessionId": "9904561",
      "coverage": [
        "only_keep",
        "school_nature",
        "short_positive_expression",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "就看公办吧",
          "assertContainsAny": [
            "公办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "assertToolNamesContain": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 2
        },
        {
          "prompt": "行，采纳",
          "assertContainsAny": [
            "已采纳",
            "公办",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustIncludeSchools",
              "contains": "院校性质:公办"
            },
            {
              "key": "planningState",
              "path": "candidatePoolState.items",
              "contains": "民办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "lengthLessThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true
            }
          ]
        }
      ]
    },
    {
      "name": "400-v156-spoken-cooperative-exclude-final-action",
      "sessionId": "9904562",
      "coverage": [
        "exclude",
        "program_type",
        "short_negative_expression",
        "final_action"
      ],
      "prompts": [
