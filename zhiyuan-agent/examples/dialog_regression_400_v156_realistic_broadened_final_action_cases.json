    {
      "name": "400-v156-deferred-region-no-plan-change",
      "sessionId": "9904565",
      "coverage": [
        "intent_change",
        "region",
        "deferred_current_plan_apply",
        "short_negative_expression",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "山东别去了，先记下，当前方案先别动",
          "assertContainsAny": [
            "山东",
