        "assertNotContains": ["已直接删除", "payload", "stage", "action_family", "volunteerId", "草稿"]
      },
      {
        "prompt": "确认",
        "assertContainsAny": ["已", "删除", "专业组"],
        "assertFollowupTarget": "ordered",
        "assertFollowupRefresh": true,
        "assertNotContains": ["payload", "stage", "action_family", "volunteerId", "草稿"]
      },
      {
        "prompt": "再从候选里补一个更贴近电气自动化或计算机的专业组",
        "assertContainsAny": ["候选", "补", "电气", "计算机", "确认"],
        "assertNotContains": ["已直接加入", "payload", "stage", "action_family", "volunteerId", "草稿"]
      },
      {
        "prompt": "确认",
        "assertContainsAny": ["已", "补", "方案"],
        "assertFollowupTarget": "ordered",
        "assertFollowupRefresh": true,
        "assertNotContains": ["payload", "stage", "action_family", "volunteerId", "草稿"]
      },
      {
        "prompt": "最后确认这版是否需要重新审查",
        "assertContainsAny": ["重新审查", "方案", "风险"],
        "assertNotContains": ["payload", "stage", "action_family", "volunteerId", "草稿"]
      }
    ]
  }
]
