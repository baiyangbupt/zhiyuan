{
  "metadata": {
    "release": "3.0.3",
    "purpose": "Anonymized dialogue-derived quality and coverage evaluation cases.",
    "source": "dialogues/*.txt summaries and transcripts, abstracted into synthetic prompts.",
    "privacy": "Do not copy real names, phone numbers, exact scores, exact ranks, or family identifiers from source transcripts."
  },
  "defaults": {
    "coverage": [
      "release_3_0_3",
      "dialogue_derived",
      "real_dialogue_source",
      "realistic_user_input"
    ],
    "assertPlanStyle": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "pending_intent_change",
        "pending_plan_action",
        "level1",
        "level2",
        "level3",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "forbiddenPatterns": [
        "payload",
        "action_family",
        "volunteerId",
        "专家推荐",
        "候选结果收紧",
        "已直接调整",
        "已直接删除",
        "已直接记录"
      ],
      "qualityFocus": [
        "actionable_next_step",
        "user_language"
      ],
      "warnElapsedSeconds": 45,
      "maxElapsedSeconds": 100
    }
  },
  "coverageMatrix": {
    "score_profile": 10,
    "eligibility_constraints": 8,
    "major_preference": 12,
    "region_preference": 10,
    "career_direction": 10,
    "budget_tuition": 8,
    "plan_review_strategy": 10,
    "plan_operations": 10,
    "followup_guard": 10
  },
  "cases": [
