{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.73 action expansion final-action checks.",
    "notes": "Run with --clone-backend-chat-session. These cases expand current-plan action coverage with spoken/deictic remove, replace, move, sort, and review-followup replacement, and verify backend mutation after confirmation."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "preview_plan_action",
      "confirm_pending",
      "realistic_user_input",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "ellipsis",
      "current_plan_action",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "17",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v173-position-unit-remove-final-action",
      "sessionId": "9904731",
      "coverage": [
        "remove_units",
        "position_reference",
        "major_group_operation",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "第三个专业组先不要了，拿掉看看",
          "assertContainsAny": [
            "第3",
            "第三",
            "专业组",
            "移出",
            "拿掉",
            "确认",
            "采纳"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "assertToolNamesContain": [
            "preview_plan_action"
          ],
          "assertActionFamiliesContain": [
            "remove_units"
          ],
          "maxToolCallCount": 2
        },
        {
          "prompt": "确认拿掉",
          "assertContainsAny": [
            "已移出",
            "已执行",
            "已更新",
            "刷新"
          ],
          "assertNoFollowups": true,
          "assertActionableFollowupTypes": [
            "planningWorkspaceAction"
          ],
          "assertActionableFollowupTargets": [
            "ordered",
            "review"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_plan_confirm",
            "pending_plan_short_text_confirm",
            "pending_plan_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "37020261000573"
            }
          ]
        }
      ]
    },
