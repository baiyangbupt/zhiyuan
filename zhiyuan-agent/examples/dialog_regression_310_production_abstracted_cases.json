  "cases": [
    {
      "name": "310-prod-only-keep-clinical-medicine",
      "sessionId": "5901",
      "flow": ["intent", "plan"],
      "coverage": [
        "major_preference",
        "hard_major_constraint",
        "only_keep_constraint",
        "plan_operations",
        "no_reverse_delete"
      ],
      "prompts": [
        {
          "prompt": "我只想学临床医学，其他专业先不要",
          "assertContainsAny": ["临床医学", "只保留", "采纳", "报考条件"],
          "assertNotContains": ["排除临床医学", "移除临床医学", "删掉临床医学"],
          "expectedKeyPoints": ["临床医学", "只保留", "采纳前不生效"],
          "qualityFocus": ["preview_confirm_boundary", "real_user_language"]
        },
        {
          "prompt": "确认",
          "assertContainsAny": ["临床医学", "已确认", "采纳", "报考条件", "后续参考"],
          "expectedKeyPoints": ["已确认", "临床医学", "后续参考"]
        }
      ]
    },
