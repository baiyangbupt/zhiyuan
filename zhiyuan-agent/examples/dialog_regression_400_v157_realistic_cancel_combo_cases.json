            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "minLength": 1,
              "notContains": "学制：5年"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
              "notContains": "管理学"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
