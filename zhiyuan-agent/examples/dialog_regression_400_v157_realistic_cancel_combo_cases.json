            }
          ]
        }
      ]
    },
    {
      "name": "400-v157-review-long-context-high-tuition-remove-final-action",
      "sessionId": "9904574",
      "coverage": [
        "review_then_plan_action",
        "long_context_reference",
        "high_tuition_remove",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "这版方案有啥问题，怎么处理，先别直接改",
          "assertContainsAny": [
            "问题",
            "风险",
            "处理",
            "高收费",
            "中外合作"
          ],
          "assertNoFollowups": true,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "review_plan"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "你说的高收费这类先去掉吧",
          "assertContainsAny": [
            "高收费",
            "移出",
            "去掉",
            "确认",
            "采纳"
          ],
          "assertContains": [
            "本次实际影响",
            "专业组"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_plan_action"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "执行",
          "assertContainsAny": [
            "已移出",
            "已执行",
            "已更新",
            "刷新"
          ],
          "assertNoFollowups": true,
          "assertActionableFollowupTypes": [
            "planningWorkspaceAction"
          ],
          "assertActionableFollowupTargets": [
            "ordered",
            "review"
          ],
          "assertActionableFollowupCount": 2,
          "expectedRoutingPathAny": [
            "direct_pending_plan_confirm",
            "pending_plan_short_text_confirm",
            "pending_plan_structured_short_text_confirm"
          ],
          "expectedToolNames": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true,
              "minLength": 1
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
              "maxNumericFieldLessThanOrEqual": {
                "field": "tuitionPerYear",
                "value": 20000
              }
            }
          ]
        }
      ]
    }
  ]
}
