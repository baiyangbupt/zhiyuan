{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.57 realistic cancel, re-issue, combo requirement, and long-context final-action checks.",
    "notes": "Run with --clone-backend-chat-session. These cases verify cancellation does not mutate planning state, later re-issued requirements still execute, combined explicit requirements are applied together, and long-context references trigger final backend actions."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "realistic_user_input",
      "cancel_or_combo",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "cancel_pending",
      "reissue_requirement",
      "combo_requirement",
      "long_context_reference",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "16",
    "fixtureContract": {
      "type": "formal_plan_present",
      "requiredState": [
        "orderedPlan",
        "formalPlan"
      ]
    },
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v157-cancel-then-reissue-public-only",
      "sessionId": "9904571",
      "coverage": [
        "cancel_pending",
        "reissue_requirement",
        "school_nature",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "民办的不要",
          "assertContainsAny": [
            "民办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "先不采纳了",
          "assertContainsAny": [
            "已取消",
            "取消",
            "不会执行",
            "继续说明"
          ],
          "assertNoFollowups": true,
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "expectedToolNames": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "cancelled"
            },
            {
              "key": "planningState",
              "path": "version",
              "unchangedFromBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeSchools",
              "notContains": "院校性质:民办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "unchangedFromBefore": true
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "unchangedFromBefore": true
            }
          ]
        },
        {
          "prompt": "那就只看公办吧",
          "assertContainsAny": [
            "公办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已采纳",
            "公办",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "expectedToolNames": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustIncludeSchools",
              "contains": "院校性质:公办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "lengthLessThanBefore": true,
              "minLength": 1
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "lengthLessThanBefore": true,
              "minLength": 1
            }
          ]
        }
      ]
    },
    {
      "name": "400-v157-combo-school-attribute-exclude-final-action",
      "sessionId": "9904572",
      "cloneBackendStateFromSessionId": "131",
      "coverage": [
        "combo_requirement",
        "school_nature",
        "program_type",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "民办和中外合作都算了吧",
