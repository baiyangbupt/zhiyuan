              "contains": [
                "院校性质:民办",
                "招生类型:中外合作"
              ]
            },
            {
              "key": "planningState",
              "path": "candidatePoolState.items",
              "contains": [
                "民办",
                "中外合作"
              ]
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.items",
              "lengthLessThanBefore": true,
              "minLength": 1
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
              "notContains": "民办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "minLength": 1,
              "notContains": "中外合作"
            }
          ]
        }
      ]
    },
    {
