    {
      "name": "400-v179-review-then-execute-without-pending-guard",
      "sessionId": "9904793",
      "coverage": [
        "review_readonly",
        "no_pending_execute_guard",
        "no_side_effect"
      ],
      "prompts": [
        {
          "prompt": "这版高收费和中外合作咋处理，先别动",
          "assertContainsAny": [
            "高收费",
            "中外合作",
            "处理",
            "风险",
            "学费"
          ],
          "assertNoFollowups": true,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "review_plan"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "执行",
          "assertContainsAny": [
            "没有待确认",
            "没有可确认",
            "不会执行",
            "不会改动"
          ],
          "assertNoFollowups": true,
          "expectedRoutingPathAny": [
            "direct_no_pending_short_text_confirm",
            "zhiyuan_agent_direct"
          ],
          "expectedToolNames": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "planningState",
              "path": "version",
              "unchangedFromBefore": true
            },
            {
              "key": "pendingConfirmation",
              "path": "$",
              "isEmpty": true
            }
          ]
        }
      ]
    },
    {
