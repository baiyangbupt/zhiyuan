{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.79 focused realistic pending rewrite/append, no-pending execute guard, and replacement quality checks.",
    "notes": "Run with --clone-backend-chat-session. These cases extend v1.78 follow-up coverage with spoken active-pending changes and final backend assertions."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "realistic_user_input",
      "pending_rewrite",
      "pending_append",
      "review_boundary",
      "replacement_quality",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "active_pending",
      "same_turn_rewrite",
      "append_requirement",
      "no_pending_execute_guard",
      "replacement_spec",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "17",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v179-active-pending-append-region-and-private-final-action",
      "sessionId": "9904791",
      "coverage": [
        "active_pending",
        "append_requirement",
        "region",
        "school_nature",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "山东别去了",
          "assertContainsAny": [
            "山东",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "再把民办也算了吧，一起记上",
          "assertContainsAny": [
            "山东",
            "民办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "assertToolNamesContain": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 2,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "active"
            },
            {
              "key": "pendingConfirmation",
              "path": "summary",
              "contains": [
                "山东",
                "民办"
              ]
            },
            {
              "key": "planningState",
              "path": "version",
              "unchangedFromBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "notContains": "山东"
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeSchools",
              "notContains": "院校性质:民办"
            }
          ]
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已采纳",
            "山东",
            "民办",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "expectedToolNames": [
            "confirm_pending"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeSchools",
              "contains": "院校性质:民办"
            },
            {
              "key": "planningState",
              "path": "candidateViewState.filters.negativeProvinceNames",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "candidatePoolState.items",
              "contains": [
                "山东",
                "民办"
              ]
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "山东"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "民办"
            }
          ]
        }
      ]
    },
