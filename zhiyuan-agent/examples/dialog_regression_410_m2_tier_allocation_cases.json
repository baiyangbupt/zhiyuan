{
  "metadata": {
    "release": "4.1.0-m2",
    "expectedCaseCount": 8,
    "expectedStepCount": 21,
    "purpose": "Verify range and ratio tier goals through one Proposal, one pending command, authoritative persistence and typed postconditions.",
    "notes": "Every case clones the same formal-plan source into an isolated session. Range and ratio requests remain hard requirements; M3 composites stay closed."
  },
  "defaults": {
    "flow": [
      "release_4_1_0_m2",
      "preview_plan_change",
      "apply_plan_change_proposal",
      "tier_allocation_postcondition"
    ],
    "coverage": [
      "range_patch_replace",
      "ratio_resolution",
      "historical_goal",
      "single_proposal_pending_command",
      "no_partial_persistence"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "16",
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "action_family",
        "volunteerId",
        "软偏好",
        "草稿"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "410-m2-range-max-satisfied-persists-without-plan-churn",
      "sessionId": "9914201",
      "fixtureContract": {
        "type": "formal_plan_present",
        "requiredState": ["orderedPlan", "formalPlan"]
      },
      "prompts": [
        {
          "prompt": "当前45个专业组总数不变，只追加一个硬要求：冲刺档最多45个，按数量范围 patch 处理，先看预览",
          "assertContains": ["45"],
          "assertContainsAny": ["冲刺", "冲最多", "冲上限", "冲0-45", "冲稳保数量范围"],
          "expectedToolNames": ["preview_plan_change"],
          "expectedToolCounts": {"preview_plan_change": 1},
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {"key": "pendingConfirmation", "path": "status", "equals": "active"},
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.plan_change_spec.tier_quota_goal",
              "equals": {
                "type": "count_ranges",
                "update_mode": "patch",
                "sprint": {"max_count": 45}
              }
            },
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_snapshot.status",
              "equals": "ready"
            },
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_snapshot.dry_run.addUnitCount",
              "equals": 0
            },
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_snapshot.dry_run.removeUnitCount",
              "equals": 0
            }
          ]
        },
        {
          "prompt": "确认执行",
          "assertContains": ["冲稳保数量范围", "校验通过"],
          "assertNoFollowups": true,
          "expectedRoutingPathAny": [
            "direct_pending_plan_confirm",
            "pending_plan_short_text_confirm",
            "pending_plan_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {"key": "pendingConfirmation", "path": "status", "equals": "applied"},
            {
              "key": "pendingConfirmation",
              "path": "resultData.postcondition_report.appliedActionCount",
              "equals": 0
            },
            {
              "key": "pendingConfirmation",
              "path": "resultData.postcondition_report.tierQuotaResult.satisfied",
              "equals": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardPlanningObjectives.tierQuotaGoal",
              "contains": {"type": "count_ranges", "sprint": {"maxCount": 45}}
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units.*.unitId",
              "unchangedFromBefore": true
            },
            {"key": "planningState", "path": "version", "greaterThanBefore": true}
          ]
        }
      ]
    },
