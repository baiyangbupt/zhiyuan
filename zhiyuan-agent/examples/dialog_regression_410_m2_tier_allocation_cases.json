    {
      "name": "410-m2-ratio-persists-source-and-canonical-resolution",
      "sessionId": "9914205",
      "fixtureContract": {
        "type": "formal_plan_present",
        "requiredState": ["orderedPlan", "formalPlan"]
      },
      "prompts": [
        {
          "prompt": "当前45个专业组总数不变，把冲稳保比例整体替换为30:40:30，先看预览",
          "assertContainsAny": ["30:40:30", "14", "18", "13", "比例"],
          "expectedToolNames": ["preview_plan_change"],
          "expectedToolCounts": {"preview_plan_change": 1},
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_apply.userGoalRequest.tierQuotaGoal",
              "contains": {
                "type": "ratios",
                "updateMode": "replace",
                "sprintWeight": 30,
                "stableWeight": 40,
                "protectWeight": 30
              }
            },
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_snapshot.tier_quota_change.resolution.canonicalWeights",
              "equals": {"sprintWeight": 3, "stableWeight": 4, "protectWeight": 3}
            },
            {
              "key": "pendingConfirmation",
              "path": "executionPayload.proposal_snapshot.tier_quota_change.resolution.resolvedCounts",
              "equals": {"sprintCount": 14, "stableCount": 18, "protectCount": 13}
            }
          ]
        },
        {
          "prompt": "确认执行",
          "assertContains": ["冲稳保比例", "校验通过"],
          "assertNoFollowups": true,
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {"key": "pendingConfirmation", "path": "status", "equals": "applied"},
            {
              "key": "planningState",
              "path": "constraintState.hardPlanningObjectives.tierQuotaGoal",
              "contains": {
                "type": "ratios",
                "sprintWeight": 30,
                "stableWeight": 40,
                "protectWeight": 30
              }
            },
            {
              "key": "planningState",
              "path": "constraintState.hardPlanningObjectives.tierQuotaResolution.canonicalWeights",
              "equals": {"sprintWeight": 3, "stableWeight": 4, "protectWeight": 3}
            },
            {
              "key": "pendingConfirmation",
              "path": "resultData.postcondition_report.tierQuotaResult.actualCounts",
              "equals": {"sprintCount": 14, "stableCount": 18, "protectCount": 13}
            }
          ]
        }
      ]
    },
