{
  "metadata": {
    "release": "4.0.0",
    "purpose": "Review/repair dialog quality and correctness regression cases.",
    "notes": "These cases focus on user-facing review and repair conversations: honest shortage handling, user-friendly issue explanations, preview-before-apply, and major/major-group repair boundaries."
  },
  "defaults": {
    "flow": [
      "plan",
      "review"
    ],
    "coverage": [
      "release_4_0_0",
      "review_repair",
      "plan_review_strategy",
      "realistic_user_input",
      "zhiyuan_agent_direct"
    ],
    "assertPlanStyle": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "pending_plan_action",
        "pending_intent_change",
        "level1",
        "level2",
        "level3",
        "硬约束",
        "修复建议",
        "暂不可用",
        "预览验证未通过",
        "不能直接应用",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "qualityFocus": [
        "rich_decision_basis",
        "actionable_next_step",
        "user_language"
      ],
      "warnElapsedSeconds": 30,
      "maxElapsedSeconds": 180,
      "minTextLengthWarn": 180
    }
  },
  "cases": [
    {
      "name": "400-review-summary-user-friendly",
      "sessionId": "132",
      "coverage": [
        "review_workspace",
        "risk_summary",
        "user_friendly_review_copy",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "这版方案帮我审查一下，风险和提醒说人话一点，先不要改",
          "assertContainsAny": [
            "审查",
            "风险",
            "提醒",
            "方案",
            "需要留意"
          ],
          "assertNoFollowups": true,
          "expectedActionFamily": "review_plan",
          "expectedKeyPoints": [
            "当前方案",
            "风险",
            "提醒",
            "下一步",
            "不会改"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "用户可理解的处理方向",
              "any": [
                "可以先看",
                "建议先",
                "需要你自己判断",
                "可以处理",
                "处理方向"
              ]
            }
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ],
      "sourceSessionId": "132",
      "cloneBackendStateFromSessionId": "132"
    },
    {
      "name": "400-review-shortage-honesty",
      "sessionId": "132",
      "coverage": [
        "review_workspace",
        "candidate_shortage",
        "safe_plan",
        "honest_shortage_boundary",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "如果稳和保不够，能不能直接帮我补齐？候选不够也要直接说",
          "assertContainsAny": [
            "稳",
            "保",
            "候选",
            "不够",
            "放宽"
          ],
          "assertNotContains": [
            "一定能补齐",
            "直接补齐就行",
            "保证补齐"
          ],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "候选",
            "缺口",
            "冲稳保",
            "放宽",
            "不会改"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "候选不足边界",
              "any": [
                "候选不足",
                "没有足够",
                "暂时不够",
                "需要放宽",
                "不能强行补"
              ]
            }
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ],
      "sourceSessionId": "132",
      "cloneBackendStateFromSessionId": "132"
    },
    {
