            "放宽",
            "人工",
            "取舍",
            "预览"
          ],
          "assertNotContains": [
            "已直接替换",
            "已直接删除"
          ],
          "expectedKeyPoints": [
            "高收费",
            "中外合作",
            "风险",
            "处理边界",
            "下一步"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "无可直接执行项时说明边界",
              "any": [
                "需要你先取舍",
                "放宽",
                "暂时没有",
                "先看具体范围",
                "不能直接"
              ]
            }
          ],
          "qualityFocus": [
            "preview_confirm_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ],
          "assertNoFollowups": true
        }
      ],
      "sourceSessionId": "130",
      "cloneBackendStateFromSessionId": "130"
    },
