{
  "metadata": {
    "release": "3.1.0",
    "purpose": "Review/repair dialog quality and correctness regression cases.",
    "notes": "These cases focus on user-facing review and repair conversations: honest shortage handling, user-friendly issue explanations, preview-before-apply, and major/major-group repair boundaries."
  },
  "defaults": {
    "flow": ["plan", "review"],
    "coverage": [
      "release_3_1_0",
      "review_repair",
      "plan_review_strategy",
      "realistic_user_input"
    ],
    "assertPlanStyle": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "pending_plan_action",
        "pending_intent_change",
        "level1",
        "level2",
        "level3",
        "硬约束",
        "修复建议",
        "暂不可用",
        "预览验证未通过",
        "不能直接应用",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "qualityFocus": [
        "rich_decision_basis",
        "actionable_next_step",
        "user_language"
      ],
      "warnElapsedSeconds": 30,
      "maxElapsedSeconds": 180,
      "minTextLengthWarn": 180
    }
  },
  "cases": [
    {
      "name": "310-review-summary-user-friendly",
      "sessionId": "132",
      "coverage": [
        "review_workspace",
        "risk_summary",
        "user_friendly_review_copy",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "这版方案帮我审查一下，风险和提醒说人话一点，先不要改",
          "assertContainsAny": ["审查", "风险", "提醒", "方案", "需要留意"],
          "assertNoFollowups": true,
          "expectedActionFamily": "review_plan",
          "expectedKeyPoints": [
            "当前方案",
            "风险",
            "提醒",
            "下一步",
            "不会改"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "用户可理解的处理方向",
              "any": ["可以先看", "建议先", "需要你自己判断", "可以处理", "处理方向"]
            }
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-shortage-honesty",
      "sessionId": "132",
      "coverage": [
        "review_workspace",
        "candidate_shortage",
        "safe_plan",
        "honest_shortage_boundary",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "如果稳和保不够，能不能直接帮我补齐？候选不够也要直接说",
          "assertContainsAny": ["稳", "保", "候选", "不够", "放宽"],
          "assertNotContains": ["一定能补齐", "直接补齐就行", "保证补齐"],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "候选",
            "缺口",
            "冲稳保",
            "放宽",
            "不会改"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "候选不足边界",
              "any": ["候选不足", "没有足够", "暂时不够", "需要放宽", "不能强行补"]
            }
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-fix-preview-then-apply",
      "sessionId": "130",
      "flow": ["review", "plan"],
      "coverage": [
        "review_then_fix",
        "preview_confirm_apply",
        "replace_units",
        "candidate_selection_reason",
        "review_workspace"
      ],
      "prompts": [
        {
          "prompt": "方案里高收费或者中外合作风险大的，先看看能怎么处理，别直接动",
          "assertContainsAny": ["高收费", "中外合作", "风险", "替换", "预览", "确认"],
          "assertNotContains": ["已直接替换", "已直接删除"],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedKeyPoints": [
            "高收费",
            "中外合作",
            "替换",
            "确认前",
            "代表样本"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "替换依据",
              "any": ["录取率", "学校层次", "专业热度", "推荐系数", "院校排名"]
            }
          ],
          "qualityFocus": [
            "preview_confirm_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        },
        {
          "prompt": "确认",
          "assertContainsAny": ["已", "处理", "调整", "方案"],
          "assertFollowupTarget": "ordered",
          "assertFollowupRefresh": true,
          "expectedKeyPoints": [
            "已调整",
            "方案",
            "审查",
            "下一步"
          ],
          "qualityFocus": [
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-major-group-inner-safety",
      "sessionId": "131",
      "coverage": [
        "majorGroup_model",
        "major_group_inner_safety",
        "compensation_preview",
        "preview_confirm_apply",
        "review_workspace"
      ],
      "prompts": [
        {
          "prompt": "专业组里面有没有录取率太悬的？能不能补一个安全一点的专业，先给我看预览",
          "assertContainsAny": ["专业组", "录取率", "安全", "补", "预览", "确认"],
          "assertNotContains": ["已直接补入", "已直接调整"],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedKeyPoints": [
            "专业组",
            "录取率",
            "安全",
            "补入",
            "确认前"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "组内安全垫依据",
              "any": ["高于组整体录取率", "组内", "录取率更高", "安全垫"]
            }
          ],
          "qualityFocus": [
            "preview_confirm_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-fix-unavailable-guidance",
      "sessionId": "132",
      "coverage": [
        "review_then_fix",
        "candidate_shortage",
        "blocked_repair_guidance",
        "user_friendly_review_copy"
      ],
      "prompts": [
        {
          "prompt": "那些现在处理不了的提醒，别给我系统话，告诉我为什么处理不了以及我该怎么调",
          "assertContainsAny": ["处理不了", "候选", "放宽", "自己调整", "建议"],
          "assertNotContains": ["暂不可用", "预览验证未通过", "不能直接应用", "硬约束"],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "处理不了",
            "候选",
            "放宽",
            "下一步"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "可感知原因",
              "any": ["候选里没有足够", "可替换空间不够", "条件太收紧", "需要放宽"]
            },
            {
              "label": "用户可执行动作",
              "any": ["放宽地域", "放宽专业", "放宽学费", "重新筛选", "手动调整"]
            }
          ]
        }
      ]
    },
    {
      "name": "310-review-professional-mode-export-boundary",
      "sessionId": "130",
      "flow": ["plan"],
      "coverage": [
        "major_model",
        "professional_mode",
        "excel_export",
        "plan_query",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "专业模式导出是不是一条志愿一行？不要按学校聚合，这个给我确认下",
          "assertContainsAny": ["专业模式", "一条志愿", "导出", "学校", "聚合"],
          "assertNotContains": ["专业组模式才", "volunteerId", "payload"],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "专业模式",
            "导出顺序",
            "不会改",
            "下一步"
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-fix-explain-hierarchy",
      "sessionId": "131",
      "coverage": [
        "review_workspace",
        "user_friendly_review_copy",
        "repair_ui_copy",
        "readonly_boundary"
      ],
      "prompts": [
        {
          "prompt": "审查里那些提醒我看不懂，你帮我分一下哪些只是看看，哪些可以自动处理",
          "assertContainsAny": ["提醒", "可以处理", "需要你", "建议", "自动"],
          "assertNotContains": ["可处理", "修复建议", "硬约束", "预览验证未通过"],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "提醒",
            "处理方向",
            "自动处理",
            "需要自己调整",
            "下一步"
          ],
          "expectedKeyPointGroups": [
            {
              "label": "层级清楚",
              "any": ["先看影响", "再决定", "可以自动处理", "需要你自己判断", "处理方向"]
            }
          ],
          "qualityFocus": [
            "readonly_boundary",
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    },
    {
      "name": "310-review-repair-after-manual-move-stale",
      "sessionId": "131",
      "coverage": [
        "review_stale",
        "move_operation",
        "plan_review_strategy",
        "preview_confirm_apply"
      ],
      "prompts": [
        {
          "prompt": "我刚手动移动过志愿，现在审查结果还准吗？需要重新看就直接说",
          "assertContainsAny": ["重新", "审查", "移动", "方案", "需要"],
          "assertNoFollowups": true,
          "expectedKeyPoints": [
            "移动",
            "重新审查",
            "当前方案",
            "下一步"
          ],
          "qualityFocus": [
            "readonly_boundary",
            "actionable_next_step",
            "user_language"
          ]
        },
        {
          "prompt": "那重新审查一下",
          "assertContainsAny": ["审查", "风险", "提醒", "方案"],
          "expectedActionFamily": "review_plan",
          "expectedKeyPoints": [
            "审查",
            "风险",
            "提醒",
            "下一步"
          ],
          "qualityFocus": [
            "rich_decision_basis",
            "actionable_next_step",
            "user_language"
          ]
        }
      ]
    }
  ]
}
