{
  "metadata": {
    "release": "4.0.0",
    "purpose": "v1.83 focused realistic follow-up coverage for active pending merge/rewrite, terse replacement, and no-pending execution boundaries.",
    "notes": "Run with --clone-backend-chat-session. These cases intentionally use shorter spoken/deictic prompts and keep final backend assertions where the user confirms an action."
  },
  "defaults": {
    "flow": [
      "release_4_0_0",
      "direct_route",
      "confirm_pending",
      "realistic_user_input",
      "pending_rewrite",
      "pending_append",
      "review_boundary",
      "replacement_quality",
      "final_action"
    ],
    "coverage": [
      "spoken_style",
      "ellipsis",
      "active_pending",
      "same_turn_rewrite",
      "append_requirement",
      "no_pending_execute_guard",
      "replacement_spec",
      "ordered_plan_final_action"
    ],
    "assertPlanStyle": true,
    "cloneBackendStateFromSessionId": "131",
    "fixtureContract": {
      "type": "formal_plan_present",
      "requiredState": [
        "orderedPlan",
        "formalPlan"
      ]
    },
    "clearBackendPlanningIntentState": true,
    "promptDefaults": {
      "assertNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3",
        "约束",
        "硬约束",
        "软偏好",
        "草稿"
      ],
      "assertThinkingNotContains": [
        "payload",
        "stage",
        "action_family",
        "volunteerId",
        "level1",
        "level2",
        "level3"
      ],
      "warnElapsedSeconds": 60,
      "maxElapsedSeconds": 180
    }
  },
  "cases": [
    {
      "name": "400-v183-active-pending-append-public-only-with-region-final-action",
      "sessionId": "9904831",
      "coverage": [
        "active_pending",
        "append_requirement",
        "region",
        "only_keep",
        "school_nature",
        "final_action"
      ],
      "prompts": [
        {
          "prompt": "山东先别去了",
          "assertContainsAny": [
            "山东",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1
        },
        {
          "prompt": "再加个只看公办，一起记上",
          "assertContainsAny": [
            "山东",
            "公办",
            "采纳",
            "确认",
            "报考要求"
          ],
          "assertFollowupType": "pendingConfirmationCard",
          "assertFollowupCount": 1,
          "expectedRoutingPath": "zhiyuan_agent_direct",
          "expectedToolNames": [
            "preview_intent_change"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "active"
            },
            {
              "key": "pendingConfirmation",
              "path": "summary",
              "contains": [
                "山东",
                "公办"
              ]
            },
            {
              "key": "planningState",
              "path": "version",
              "unchangedFromBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "notContains": "山东"
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustIncludeSchools",
              "notContains": "院校性质:公办"
            }
          ]
        },
        {
          "prompt": "采纳",
          "assertContainsAny": [
            "已采纳",
            "山东",
            "公办",
            "当前方案",
            "报考要求"
          ],
          "expectedRoutingPathAny": [
            "direct_pending_intent_confirm",
            "pending_intent_short_text_confirm",
            "pending_intent_structured_short_text_confirm"
          ],
          "maxToolCallCount": 1,
          "assertBackendExtraData": [
            {
              "key": "pendingConfirmation",
              "path": "status",
              "equals": "applied"
            },
            {
              "key": "planningState",
              "path": "version",
              "greaterThanBefore": true
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustExcludeRegions",
              "contains": "山东"
            },
            {
              "key": "planningState",
              "path": "constraintState.hardConstraints.mustIncludeSchools",
              "contains": "院校性质:公办"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "山东"
            },
            {
              "key": "planningState",
              "path": "orderedPlanState.units",
              "notContains": "民办"
            }
          ]
        }
      ]
    },
