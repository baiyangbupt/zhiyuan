[
  {
    "caseId": "P1-explicit-prefer-preview",
    "batch": "01",
    "previewPayload": {
      "status": "ready",
      "title": "待确认地域偏好",
      "intentMode": "preference",
      "analysisStage": "confirmed",
      "items": [
        {
          "content": "偏好地域：北京",
          "selected": true,
          "value": {"city_intents": {"province": ["北京"]}}
        }
      ]
    },
    "expected": {
      "pendingType": "intent_change",
      "requiresConfirmation": true,
      "executionPayload": {"kind": "pending_intent_change"},
      "intentPayload": {
        "intentMode": "preference",
        "constraintIntentType": "default",
        "batch": "01",
        "merged": {"city_intents": {"province": ["北京"]}}
      },
      "displayPayload": {"presentation": "confirmation_card", "summary": "偏好地域：北京"}
    },
    "assert": {
      "exact": [
        "pendingType",
        "requiresConfirmation",
        "executionPayload.kind",
        "intentPayload.intentMode",
        "intentPayload.constraintIntentType",
        "intentPayload.batch",
        "intentPayload.merged",
        "displayPayload.presentation",
        "displayPayload.summary"
      ]
    }
  },
  {
    "caseId": "P2-explicit-only-keep-preview",
    "batch": "01",
    "previewPayload": {
      "status": "ready",
      "title": "确认这条要求",
      "intentMode": "constraint",
      "constraintIntentType": "only_keep",
      "analysisStage": "confirmed",
      "items": [
        {
          "content": "只保留专业：临床医学",
          "selected": true,
          "value": {"major_intents": {"level3": ["临床医学"]}}
        }
      ]
    },
    "expected": {
      "pendingType": "intent_change",
      "requiresConfirmation": true,
      "intentPayload": {
        "intentMode": "constraint",
        "constraintIntentType": "only_keep",
        "merged": {"major_intents": {"level3": ["临床医学"]}}
      }
    },
    "assert": {
      "exact": [
        "pendingType",
        "requiresConfirmation",
        "intentPayload.intentMode",
        "intentPayload.constraintIntentType",
        "intentPayload.merged"
      ]
    }
  },
  {
    "caseId": "P3-unconfirmed-preview-blocked",
    "previewPayload": {
      "status": "ready",
      "intentMode": "preference",
      "analysisStage": "preview",
      "items": [
        {
          "content": "偏好地域：北京",
          "selected": true,
          "value": {"city_intents": {"province": ["北京"]}}
        }
      ]
    },
    "expected": {"pendingType": "none", "requiresConfirmation": false},
    "assert": {
      "exact": ["pendingType", "requiresConfirmation"],
      "containsBlockingReasons": ["intent_preview_requires_confirmed_stage"]
    }
  },
  {
    "caseId": "P4-ready-without-selected-blocked",
    "previewPayload": {
      "status": "ready",
      "intentMode": "preference",
      "analysisStage": "confirmed",
      "items": [
        {
          "content": "偏好地域：北京",
          "selected": false,
          "value": {"city_intents": {"province": ["北京"]}}
        }
      ]
    },
    "expected": {"pendingType": "none", "requiresConfirmation": false},
    "assert": {
      "exact": ["pendingType", "requiresConfirmation"],
      "containsBlockingReasons": ["intent_preview_requires_selected_values"]
    }
  },
  {
    "caseId": "P5-only-keep-without-scope-blocked",
    "previewPayload": {
      "status": "ready",
      "intentMode": "constraint",
      "constraintIntentType": "only_keep",
      "analysisStage": "confirmed",
      "items": [
        {
          "content": "未来职业：医生",
          "selected": true,
          "value": {"career_intents": {"careers": ["医生"]}}
        }
      ]
    },
    "expected": {"pendingType": "none", "requiresConfirmation": false},
    "assert": {
      "exact": ["pendingType", "requiresConfirmation"],
      "containsBlockingReasons": ["constraint_intent_requires_scope"]
    }
  }
]
