LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=kimi-k2.6
LLM_API_KEY=<set-in-runtime-env>
LLM_BASE_URL=<set-in-runtime-env>
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=0
LLM_CONNECT_TIMEOUT_SECONDS=15

# 官方来源联网检索。未配置 BOCHA_API_KEY 时，政策/章程工具会降级为通用判断框架。
BOCHA_API_KEY=<set-in-runtime-env>
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
BOCHA_TIMEOUT_SECONDS=10

# Logfire 配置
LOGFIRE_TOKEN=your_logfire_token_here
LOGFIRE_ENABLED=true

# Backend defaults to loopback; explicitly set the trusted backend for each environment.
INTERNAL_SERVICE_URL=http://127.0.0.1:8090
# Provision the same strong secret for Java, Agent, MCP and internal probes at runtime.
# Java property: internal.service.token. HTTP header: X-Internal-Service-Token.
# Empty is NOT an auth bypass: Java rejects all protected requests until configured.
# Export this key for Codex/MCP child processes; do not rely only on this dotenv file.
INTERNAL_SERVICE_TOKEN=
